[gd_resource type="Resource" script_class="TurretBranchData" load_steps=5 format=3]

[ext_resource type="Script" path="res://data/types/turret_branch_data.gd" id="1"]
[ext_resource type="Script" path="res://data/types/card_effect.gd" id="2"]

[sub_resource type="Resource" id="eff1"]
