[gd_resource type="Resource" script_class="TurretBranchData" load_steps=5 format=3]

[ext_resource type="Script" path="res://data/types/turret_branch_data.gd" id="1"]
[ext_resource type="Script" path="res://data/types/card_effect.gd" id="2"]

[sub_resource type="Resource" id="eff1"]
script = ExtResource("2")
op = 1
stat = &"turret.frost.slow_factor"
value = 0.7

[sub_resource type="Resource" id="eff2"]
script = ExtResource("2")
op = 0
stat = &"turret.frost.slow_duration"
value = 1.2

[sub_resource type="Resource" id="eff3"]
script = ExtResource("2")
op = 1
stat = &"turret.frost.attack_interval"
value = 0.9

[resource]
script = ExtResource("1")
id = &"frost_control"
turret_id = &"frost"
display_name = "Deep Chill"
description = "Frost Turrets lock targets down for longer, reinforcing lane control and safer setup windows."
excludes_branches = Array[StringName]([&"frost_expose"])
projectile_visual = &"ice_shard_control"
effects = Array[ExtResource("2")]([SubResource("eff1"), SubResource("eff2"), SubResource("eff3")])
